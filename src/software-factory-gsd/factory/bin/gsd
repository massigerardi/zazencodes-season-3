#!/usr/bin/env python3
"""Bridge between GSD's .planning/ files and the factory backlog.

  gsd backlog <phase> [--after ID=ID[,ID...]]... [--dry-run]
      Queue every unticked requirement of a ROADMAP phase in factory/backlog.md,
      one line per requirement ID. Items wait for the unticked requirements of the
      phases this one depends on; --after adds same-phase dependencies.
  gsd next
      Print the first unchecked backlog item whose dependencies are all ticked, as
      JSON {"line", "feature", "requirement"}. Exit 3 if every item is blocked,
      4 if the backlog has no unchecked item.
  gsd tick <ID>
      Tick a requirement in .planning/REQUIREMENTS.md and mark its traceability
      row Complete. Says so when that completes its phase.

A requirement is done when it is ticked in REQUIREMENTS.md. Run from the main
checkout; paths resolve against its git root.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

ID = r"[A-Z][A-Z0-9]*-\d+"
REQ_LINE = re.compile(rf"^(\s*- \[)([ xX])(\] \*\*({ID})\*\*:?\s*)(.*)$")
PHASE_HEAD = re.compile(r"^(#{2,4})\s+Phase\s+(\d+(?:\.\d+)*)\s*:\s*(.*?)\s*$")
FIELD = r"^\*\*{name}:?\*\*:?\s*(.*)$"
ITEM = re.compile(r"^- \[([ xX])\] (.*)$")
ITEM_ID = re.compile(rf"^({ID}):")
AFTER = re.compile(r"\s*\(after ([^)]*)\)")
PHASE_TAG = re.compile(r"\s*\[phase [^\]]*\]")

BACKLOG_HEADER = """# Backlog

`/factory next` builds the first unchecked item whose `(after ...)` requirements
are ticked in `.planning/REQUIREMENTS.md`, and checks it off with its job id.
`/factory from-gsd <phase>` adds a phase's requirements here.

"""


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def root():
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError):
        die("Not inside a git repository.")
    return Path(out.stdout.strip())


def norm_phase(p):
    return ".".join(str(int(s)) for s in p.split("."))


def read(path):
    if not path.is_file():
        die(f"{path} not found. Run /gsd-new-project first.")
    return path.read_text().splitlines()


def requirements(lines):
    """{ID: (ticked, description)} from REQUIREMENTS.md checkbox lines."""
    reqs = {}
    for line in lines:
        m = REQ_LINE.match(line)
        if m and m.group(4) not in reqs:
            reqs[m.group(4)] = (m.group(2) in "xX", m.group(5).strip())
    return reqs


def phases(lines):
    """{phase: {name, requirements, depends}} for ROADMAP phases that list requirements."""
    found = {}
    i = 0
    while i < len(lines):
        m = PHASE_HEAD.match(lines[i])
        if not m:
            i += 1
            continue
        level, num, name = len(m.group(1)), norm_phase(m.group(2)), m.group(3)
        j = i + 1
        while j < len(lines) and not re.match(rf"^#{{1,{level}}}\s", lines[j]):
            j += 1
        block = lines[i + 1:j]
        reqs = field(block, "Requirements")
        if reqs is not None and num not in found:
            dep = field(block, "Depends on") or ""
            found[num] = {
                "name": name,
                "requirements": re.findall(ID, reqs),
                "depends": [norm_phase(p) for p in re.findall(r"Phase\s+(\d+(?:\.\d+)*)", dep)],
            }
        i = j
    return found


def field(block, name):
    pat = re.compile(FIELD.format(name=re.escape(name)), re.IGNORECASE)
    for line in block:
        m = pat.match(line.strip())
        if m:
            return m.group(1)
    return None


def backlog_items(lines):
    for line in lines:
        m = ITEM.match(line)
        if m:
            yield line, m.group(1) in "xX", m.group(2)


def item_after(text):
    m = AFTER.search(text)
    return re.findall(ID, m.group(1)) if m else []


def cmd_backlog(args):
    if not args:
        die("usage: gsd backlog <phase> [--after ID=ID[,ID...]]... [--dry-run]")
    phase, extra, dry = norm_phase(args[0]), {}, False
    rest = args[1:]
    while rest:
        a = rest.pop(0)
        if a == "--dry-run":
            dry = True
        elif a == "--after" and rest:
            key, _, val = rest.pop(0).partition("=")
            if not re.fullmatch(ID, key) or not val:
                die(f"--after wants ID=ID[,ID...], got {key}={val}")
            extra.setdefault(key, []).extend(re.findall(ID, val))
        else:
            die(f"unknown argument: {a}")

    base = root()
    reqs = requirements(read(base / ".planning/REQUIREMENTS.md"))
    road = phases(read(base / ".planning/ROADMAP.md"))
    if phase not in road:
        die(f"Phase {phase} has no **Requirements** line in .planning/ROADMAP.md.")
    p = road[phase]
    unknown = [r for r in p["requirements"] if r not in reqs]
    if unknown:
        die(f"Phase {phase} lists requirements missing from REQUIREMENTS.md: {', '.join(unknown)}")
    for key, vals in extra.items():
        if key not in p["requirements"]:
            die(f"--after {key}: not a requirement of phase {phase}")
        bad = [v for v in vals if v not in reqs]
        if bad:
            die(f"--after {key}: unknown requirements {', '.join(bad)}")

    blocking = []
    for dep in p["depends"]:
        if dep not in road:
            die(f"Phase {phase} depends on phase {dep}, which is not in ROADMAP.md.")
        blocking += [r for r in road[dep]["requirements"] if not reqs[r][0] and r not in blocking]

    path = base / "factory/backlog.md"
    existing = path.read_text() if path.is_file() else BACKLOG_HEADER
    queued = {ITEM_ID.match(t).group(1)
              for _, _, t in backlog_items(existing.splitlines()) if ITEM_ID.match(t)}

    new, skipped = [], []
    for r in p["requirements"]:
        ticked, desc = reqs[r]
        if ticked or r in queued:
            skipped.append(f"{r} ({'ticked' if ticked else 'already queued'})")
            continue
        after = blocking + [a for a in extra.get(r, []) if a not in blocking]
        suffix = f" (after {', '.join(after)})" if after else ""
        new.append(f"- [ ] {r}: {desc} [phase {phase}]{suffix}")

    for line in new:
        print(line)
    if skipped:
        print(f"Skipped: {', '.join(skipped)}", file=sys.stderr)
    if not new:
        print(f"Nothing to queue for phase {phase}.", file=sys.stderr)
        return
    if not dry:
        if not existing.endswith("\n"):
            existing += "\n"
        path.write_text(existing + "\n".join(new) + "\n")


def cmd_next(args):
    base = root()
    path = base / "factory/backlog.md"
    lines = path.read_text().splitlines() if path.is_file() else []
    req_path = base / ".planning/REQUIREMENTS.md"
    reqs = requirements(req_path.read_text().splitlines()) if req_path.is_file() else {}

    blocked, open_count = [], 0
    for line, done, text in backlog_items(lines):
        if done:
            continue
        open_count += 1
        waiting = []
        for a in item_after(text):
            if a not in reqs:
                waiting.append(f"{a} (not in REQUIREMENTS.md)")
            elif not reqs[a][0]:
                waiting.append(a)
        if waiting:
            blocked.append(f"{text}\n    waiting on: {', '.join(waiting)}")
            continue
        m = ITEM_ID.match(text)
        feature = PHASE_TAG.sub("", AFTER.sub("", text)).strip()
        print(json.dumps({"line": line, "feature": feature,
                          "requirement": m.group(1) if m else None}))
        return
    if not open_count:
        print("No unchecked items in factory/backlog.md.")
        sys.exit(4)
    print("Every unchecked item is waiting on unticked requirements:")
    print("\n".join(f"- {b}" for b in blocked))
    sys.exit(3)


def cmd_tick(args):
    if len(args) != 1 or not re.fullmatch(ID, args[0]):
        die("usage: gsd tick <ID>")
    rid = args[0]
    base = root()
    path = base / ".planning/REQUIREMENTS.md"
    lines = read(path)
    hit, already = False, False
    for i, line in enumerate(lines):
        m = REQ_LINE.match(line)
        if m and m.group(4) == rid and not hit:
            hit, already = True, m.group(2) in "xX"
            lines[i] = f"{m.group(1)}x{m.group(3)}{m.group(5)}"
            continue
        cells = line.split("|")
        if len(cells) >= 4 and line.strip().startswith("|") and cells[1].strip() == rid:
            cells[-2 if cells[-1].strip() == "" else -1] = " Complete "
            lines[i] = "|".join(cells)
    if not hit:
        die(f"{rid} is not a checkbox requirement in .planning/REQUIREMENTS.md.")
    path.write_text("\n".join(lines) + "\n")
    print(f"{rid} was already ticked." if already else f"Ticked {rid}.")

    reqs = requirements(lines)
    road_path = base / ".planning/ROADMAP.md"
    if road_path.is_file():
        for num, p in phases(road_path.read_text().splitlines()).items():
            if rid in p["requirements"] and all(reqs.get(r, (False,))[0] for r in p["requirements"]):
                print(f"Phase {num} ({p['name']}) complete: all {len(p['requirements'])} requirements ticked.")


def main():
    cmds = {"backlog": cmd_backlog, "next": cmd_next, "tick": cmd_tick}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        die(__doc__.strip())
    cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
